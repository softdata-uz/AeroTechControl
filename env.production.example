# Copy this file to `.env.production` and set the real backend address before
# running `npm run build`. Used only by `next build` (static export) — it is
# baked into the client bundle at build time, so there is no server at runtime
# to read it, and the app must be rebuilt whenever the backend's address
# changes.
NEXT_PUBLIC_API_URL=http://SERVER_IP:3000/api/v1
